  "title": "PopScenario",
  "type": "object",
  "properties": {
    "pop_services": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/PopService"
      }
    },
    "pop_actions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/PopAction"
      }
    },
    "pop_postgres": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopPostgres"
        },
        {
          "type": "null"
        }
      ]
    },
    "pop_kafka": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopKafka"
        },
        {
          "type": "null"
        }
      ]
    },
    "pop_server": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopServer"
        },
        {
          "type": "null"
        }
      ]
    },
    "pop_keycloak": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopKeycloak"
        },
        {
          "type": "null"
        }
      ]
    },
    "pop_sqlite": {
      "anyOf": [

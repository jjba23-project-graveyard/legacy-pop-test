        "dir": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "shell_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_cmd_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env_vars": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "health_check": {
          "$ref": "#/$defs/PopServiceHealthAction"
        },
        "postgres": {
          "anyOf": [
            {
              "$ref": "#/$defs/PopServicePostgres"
            },
            {
              "type": "null"
            }
          ]

          },
          "required": [
            "path",
            "patience_seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "always_healthy": {
              "type": "boolean"
            }
          },
          "required": [
            "always_healthy"
          ]
        }
      ]
    },
    "PopServicePostgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "host_var": {
          "type": [
            "string",
            "null"
          ]
        },
        "port_var": {
          "type": [
            "string",
            "null"
          ]
        },
        "db_var": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_var": {
          "type": [
            "string",
            "null"
          ]
        },
        "pass_var": {
          "type": [
            "string",

            },
            {
              "type": "null"
            }
          ]
        },
        "pop_server": {
          "anyOf": [
            {
              "$ref": "#/$defs/PopServicePopServer"
            },
            {
              "type": "null"
            }
          ]
        },
        "keycloak": {
          "anyOf": [
            {
              "$ref": "#/$defs/PopServiceKeycloak"
            },
            {
              "type": "null"

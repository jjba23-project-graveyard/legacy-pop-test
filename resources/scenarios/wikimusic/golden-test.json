{
  "pop_services": [
    {
      "id": "wikimusic",
      "dir": "$HOME/Ontwikkeling/Persoonlijk/wikimusic",
      "base_url": "http://localhost:50050",
      "start_cmd_args": [
        "guix shell -m manifest.scm -- art work"
      ],
      "health_check": {
        "path": "/",
        "patience_seconds": 30
      }
    }
  ],
  "pop_actions": [
    {
      "name": "Check that the welcome page works well",
      "assert_url": "/",
      "method": "GET",
      "assert_code": 200,
      "service_id": "wikimusic",
      "html_patterns": [
        "h2"
      ]
    }
  ]
}
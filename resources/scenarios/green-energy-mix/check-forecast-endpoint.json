{
  "pop_services": [
    {
      "id": "green-energy-mix",
      "dir": "$HOME/Ontwikkeling/Werk/Vandebron",
      "base_url": "http://localhost:50000",
      "start_cmd_args": [
        "sbt \"greenEnergyMix/run\""
      ],
      "env_vars": {
        "NATIONAAL_ENERGIE_DASHBOARD_TOKEN": "002b9a99a4d98cdee8aabf3abb0778cb649126ffbffc1bcde516884797809ce9"
      },
      "health_check": {
        "path": "/health",
        "patience_seconds": 120
      }
    }
  ],
  "pop_actions": [
    {
      "assert_url": "/api/v1/forecast",
      "service_id": "green-energy-mix",
      "json_body_patterns": [
        {
          "pattern": "\"meta\"\"forecastDate\"",
          "condition": "!= \"\""
        },
        {
          "pattern": "\"data\"[0]\"load\"",
          "condition": "> 0"
        },
        {
          "pattern": "\"data\"[0]\"solar\"",
          "condition": ">= 0"
        }
      ]
    }
  ]
}
